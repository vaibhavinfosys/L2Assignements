
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="L2Track Cross Browser Suite">

    <listeners>
        <listener class-name="com.l2track.listeners.TestListener"/>
    </listeners>

    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.l2track.tests.FileUploadTest"/>
            <class name="com.l2track.tests.FileDownloadTest"/>
        </classes>
    </test>

    

</suite>
